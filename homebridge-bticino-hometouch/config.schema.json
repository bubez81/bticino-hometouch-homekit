{
  "pluginAlias": "BTicinoHometouch",
  "pluginType": "platform",
  "singular": true,
  "headerDisplay": "BTicino HOMETOUCH video door entry for Apple Home: ring notifications, live view with two-way audio, one lock per entrance. Sign in once with a dedicated Door Entry account; the plugin runs everything else.",
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Name in Apple Home",
        "type": "string",
        "default": "Videocitofono",
        "required": true
      },
      "entrances": {
        "title": "Entrances",
        "description": "One lock per entrance appears inside the doorbell. The address is the entrance panel's lock address (usually 20 for the first, 21 for the second).",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "title": "Name",
              "type": "string",
              "required": true
            },
            "address": {
              "title": "Address",
              "type": "string",
              "pattern": "^[0-9]{1,4}$",
              "required": true
            }
          }
        }
      },
      "liveAudio": {
        "title": "Sound in the live view",
        "type": "boolean",
        "default": true
      },
      "homeAssistant": {
        "title": "Home Assistant",
        "type": "object",
        "properties": {
          "enabled": {
            "title": "Allow the Home Assistant integration to connect",
            "type": "boolean",
            "default": false
          },
          "port": {
            "title": "Port",
            "type": "integer",
            "default": 8790,
            "minimum": 1024,
            "maximum": 65535
          },
          "allowedClients": {
            "title": "Allowed Home Assistant addresses (empty: any on the LAN)",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "liveRtspUrl": {
            "title": "Live RTSP URL for Home Assistant (optional, go2rtc)",
            "type": "string"
          }
        }
      },
      "pythonPath": {
        "title": "Python 3 (advanced)",
        "type": "string",
        "placeholder": "python3"
      },
      "ffmpegPath": {
        "title": "FFmpeg (advanced; default: ffmpeg-for-homebridge)",
        "type": "string"
      },
      "storagePath": {
        "title": "Data folder (advanced; default: Homebridge storage/bticino-hometouch)",
        "type": "string"
      },
      "ipcSocket": {
        "title": "Listener socket (advanced; for go2rtc or the MQTT bridge, e.g. /tmp/bticino-hometouch.sock)",
        "type": "string"
      }
    }
  },
  "layout": [
    "name",
    {
      "key": "entrances",
      "type": "array",
      "buttonText": "Add entrance",
      "items": [
        "entrances[].name",
        "entrances[].address"
      ]
    },
    "liveAudio",
    {
      "type": "fieldset",
      "title": "Home Assistant",
      "expandable": true,
      "items": [
        "homeAssistant.enabled",
        "homeAssistant.port",
        "homeAssistant.allowedClients",
        "homeAssistant.liveRtspUrl"
      ]
    },
    {
      "type": "fieldset",
      "title": "Advanced",
      "expandable": true,
      "items": [
        "pythonPath",
        "ffmpegPath",
        "storagePath",
        "ipcSocket"
      ]
    }
  ],
  "customUi": true
}

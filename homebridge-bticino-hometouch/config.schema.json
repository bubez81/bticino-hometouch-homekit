      ,"enableHapLive": {"type": "boolean", "default": false}
      ,"enableCamera": {"type": "boolean", "default": false}
      ,"enableTwoWayAudio": {"type": "boolean", "default": false}
      ,"enableCallUnlock": {"type": "boolean", "default": false}
      ,"separateCallUnlock": {"type": "boolean", "default": false}
    },
    "additionalProperties": false
  }
}

{
  "pluginAlias": "BTicinoHOMETOUCH",
  "pluginType": "accessory",
  "schema": {
    "type": "object",
    "properties": {
      "name": {"type": "string", "default": "BTicino HOMETOUCH"},
      "configPath": {"type": "string", "minLength": 1},
      "listenerPath": {"type": "string", "minLength": 1}
      ,"ipcSocket": {"type": "string", "minLength": 1}
      ,"candidate": {"type": "string", "pattern": "^[1-4]$"}
      ,"enableHapLive": {"type": "boolean", "default": false}
      ,"enableCamera": {"type": "boolean", "default": false}
      ,"enableTwoWayAudio": {"type": "boolean", "default": false}
      ,"liveAudio": {"type": "boolean", "default": true, "description": "On-demand live view carries the entrance panel sound and, when Home unmutes the microphone, your voice. Needs enableTwoWayAudio and audio_ffmpeg (FFmpeg with libspeex) in the listener config."}
      ,"talkPort": {"type": "integer", "minimum": 1024, "maximum": 65535, "default": 22310}
      ,"enableCallUnlock": {"type": "boolean", "default": false}
      ,"separateCallUnlock": {"type": "boolean", "default": false}
      ,"standalone": {"type": "boolean", "default": false}
      ,"serialNumber": {"type": "string", "minLength": 1}
      ,"ffmpegPath": {"type": "string", "minLength": 1}
      ,"audioFfmpegPath": {"type": "string", "minLength": 1}
    },
    "additionalProperties": false
  }
}

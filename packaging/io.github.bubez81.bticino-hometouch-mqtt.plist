<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>io.github.bubez81.bticino-hometouch-mqtt</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/bticino-sniffer/venv-mqtt/bin/python</string>
        <string>/opt/bticino-sniffer/bticino_mqtt_bridge.py</string>
        <string>--config</string>
        <string>/opt/bticino-sniffer/private/mqtt.json</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/opt/bticino-sniffer</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>StandardOutPath</key>
    <string>/opt/bticino-sniffer/mqtt-bridge.log</string>
    <key>StandardErrorPath</key>
    <string>/opt/bticino-sniffer/mqtt-bridge.err</string>
</dict>
</plist>
